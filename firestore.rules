rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single role: anyone whose Google email is an active document in /staff
    // can read and write everything. There is no finer-grained access by design.
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()));
    }
    function isStaff() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()))
        && staffDoc().data.active == true;
    }

    // ---- Public exception 1: the published form snapshot is readable by anyone. ----
    match /publicForms/{formId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---- Public exception 2: customers create one validated submission. ----
    // Any signed-in user may create (the public page signs in anonymously first).
    // Quantities are re-validated and clamped by the staff import; the rules bound the shape.
    function pub() {
      return get(/databases/$(database)/documents/publicForms/$(request.resource.data.formId));
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function validCustomer(c) {
      return c is map
        && c.keys().hasOnly(['name', 'email', 'phone', 'address'])
        && c.keys().hasAll(['name', 'email', 'phone'])
        && str(c.name, 120) && c.name.size() > 0
        && str(c.email, 160) && str(c.phone, 60)
        && (!('address' in c) || str(c.address, 600));
    }
    function validShipping(d) {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        && d.customerUid == request.auth.uid
        && d.postalCode is string && d.postalCode.matches('^[1-9][0-9]{4}$')
        && d.shipping is map && d.shipping.keys().hasOnly(['quoteId', 'service']) && d.shipping.keys().hasAll(['quoteId', 'service'])
        && str(d.shipping.quoteId, 40) && d.shipping.quoteId.size() > 0
        // 'service' is a keyword in the rules language, so it is read by index.
        && str(d.shipping['service'], 40) && d.shipping['service'].size() > 0;
    }
    function validSubmission() {
      let d = request.resource.data;
      let p = pub();
      return d.keys().hasOnly(['formId', 'eventId', 'batchId', 'version', 'code', 'customer', 'fulfilment', 'pickupDay', 'paymentProofUrl', 'notes', 'lines', 'submittedAt', 'status', 'orderType', 'seen', 'createdAt', 'paymentMethod', 'postalCode', 'shipping', 'customerUid'])
        && d.keys().hasAll(['formId', 'eventId', 'batchId', 'version', 'code', 'customer', 'fulfilment', 'notes', 'lines', 'submittedAt', 'status'])
        && str(d.formId, 40) && p.data.enabled == true
        && d.eventId == p.data.eventId && d.batchId == p.data.batchId
        && d.version is int
        && str(d.code, 16)
        && validCustomer(d.customer)
        && d.fulfilment in ['pickup', 'mail']
        && (!('pickupDay' in d) || str(d.pickupDay, 80))
        && (!('paymentProofUrl' in d) || str(d.paymentProofUrl, 1000))
        && str(d.notes, 1000)
        && d.lines is map && d.lines.size() >= 1 && d.lines.size() <= 60
        && d.lines.keys().hasOnly(p.data.items.keys())
        && d.submittedAt is number
        && d.status == 'new'
        && (!('orderType' in d) || d.orderType in ['preorder', 'mail_order'])
        && (!('seen' in d) || (d.seen is map && d.seen.size() <= 60))
        && (!('paymentMethod' in d) || str(d.paymentMethod, 60))
        // Shipped orders need a Google sign-in, a postcode and a quote; pickups carry none of it.
        && (d.fulfilment == 'mail' ? validShipping(d) : !('postalCode' in d) && !('shipping' in d) && !('customerUid' in d))
        // Server time, so the importer can apply the price grace period fairly.
        && (!('createdAt' in d) || d.createdAt == request.time)
        // The batch dates: no submissions before the opening day or after the closing day.
        && (!('acceptFrom' in p.data) || request.time.toMillis() >= p.data.acceptFrom)
        && (!('acceptUntil' in p.data) || request.time.toMillis() <= p.data.acceptUntil);
    }
    match /submissions/{id} {
      allow create: if request.auth != null && validSubmission();
      allow read, update, delete: if isStaff();
    }

    // ---- Public exception 4: the storefront catalogue and the mail-order switch. ----
    // Orders from the storefront go through the submission rules above: each storefront lane
    // is a publicForms document (store_<batchId>, store_mail).
    match /publicStore/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---- Public exception 3: the live price list both customer pages read. ----
    match /publicPrices/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---- Public exception 6: the customer's copy of an order (written by a function only). ----
    // The document id is a 128-bit secret sent in the order e-mails: anyone holding it can open
    // that one copy. A signed-in customer can list the copies carrying their uid. No one lists
    // the collection otherwise, and the copies hold no address, phone or e-mail.
    match /customerOrders/{token} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---- Public exception 5: the /shop/ contact form. ----
    // Any signed-in user (the shop signs in anonymously) creates one validated message; a function
    // files it into the shared inbox. Only staff read them.
    function validContact() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'subject', 'message', 'orderRef', 'status', 'submittedAt', 'createdAt'])
        && d.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'submittedAt'])
        && str(d.name, 120) && d.name.size() > 0
        && str(d.email, 160) && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(d.subject, 200)
        && str(d.message, 5000) && d.message.size() > 0
        && (!('orderRef' in d) || str(d.orderRef, 40))
        && d.status == 'new'
        && d.submittedAt is number
        && (!('createdAt' in d) || d.createdAt == request.time);
    }
    match /contactSubmissions/{id} {
      allow create: if request.auth != null && validContact();
      allow read: if isStaff();
    }

    // ---- Mail: written by functions. Staff read everything and only file threads. ----
    // A thread update may change the folder, read state, flags and who is replying, nothing else.
    match /mailThreads/{id} {
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['folder', 'unread', 'flags', 'spamReason', 'replying'])
        && request.resource.data.folder in ['inbox', 'archive', 'spam'];
    }
    match /mailMessages/{id} {
      allow read: if isStaff();
    }
    match /mailQuota/{id} {
      allow read: if isStaff();
    }

    // ---- Append-only collections: logs and price history. ----
    // These and the mail collections above are kept out of the catch-all below, because rules that match the same path add up:
    // a catch-all "write" would otherwise allow updates and deletes here.
    match /logs/{id} {
      allow read, create: if isStaff();
    }
    match /priceHistory/{id} {
      allow read, create: if isStaff();
    }

    match /{collection}/{document=**} {
      allow read, write: if isStaff() && !(collection in ['logs', 'priceHistory', 'contactSubmissions', 'mailThreads', 'mailMessages', 'mailQuota']);
    }
  }
}
